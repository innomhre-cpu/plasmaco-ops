# Copy to deploy/.env and fill in. deploy/.env is ignored by git.
# Database password: any long random string, e.g. `openssl rand -base64 24`.
PLASMACO_DB_PASSWORD=
# Token signing key: base64 of at least 32 random bytes, e.g. `openssl rand -base64 48`.
PLASMACO_JWT_SECRET=
PLASMACO_TIME_ZONE=Africa/Kigali
# Negative-stock override stays off unless management decides otherwise (every override is audited).
PLASMACO_ALLOW_NEGATIVE_OVERRIDE=false
# First start only: creates the first administrator when the database has no users. Remove both afterwards.
PLASMACO_BOOTSTRAP_ADMIN_USERNAME=
PLASMACO_BOOTSTRAP_ADMIN_PASSWORD=
