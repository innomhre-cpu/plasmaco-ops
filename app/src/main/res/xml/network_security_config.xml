<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. A plant-network server must present a valid certificate (or a private CA added below). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
