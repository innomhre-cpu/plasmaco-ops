<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Plasmaco" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/plasmaco_background_dark</item>
    </style>
    <style name="Theme.Plasmaco.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/plasmaco_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Plasmaco</item>
    </style>
</resources>
